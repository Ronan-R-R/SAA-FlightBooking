<UserControl x:Class="SAA.DesktopApp.Views.BookingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Bookings" Style="{StaticResource H1}"/>
                <TextBlock Text="Bookings with the passenger who booked and payment status." Style="{StaticResource Muted}"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Padding="16,7" Click="Refresh_Click" Cursor="Hand"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="Grid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reference" Binding="{Binding BookingReference}" Width="120"/>
                        <DataGridTextColumn Header="Booked By" Binding="{Binding BookedBy}" Width="*"/>
                        <DataGridTextColumn Header="Booking Status" Binding="{Binding Status}" Width="150"/>
                        <DataGridTextColumn Header="Amount (ZAR)" Binding="{Binding Amount, StringFormat=N2}" Width="140"/>
                        <DataGridTextColumn Header="Payment Status" Binding="{Binding PaymentStatus}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4"/>
                    <TextBlock Text="Loading bookings..." Style="{StaticResource Muted}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="Empty" Text="No bookings found." Style="{StaticResource Muted}"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>

                <StackPanel x:Name="Error" VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="420" Visibility="Collapsed">
                    <TextBlock Text="Could not load data" Style="{StaticResource H2}" HorizontalAlignment="Center" Foreground="#D9534F"/>
                    <TextBlock x:Name="ErrorText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
