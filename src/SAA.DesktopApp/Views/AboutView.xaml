<UserControl x:Class="SAA.DesktopApp.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="About" Style="{StaticResource H1}"/>
            <TextBlock Text="Application and project information." Style="{StaticResource Muted}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="SAA Flight Booking System" Style="{StaticResource H2}" FontSize="18"/>
                <TextBlock Text="CTU PM02" Foreground="{StaticResource Gold}" FontFamily="Segoe UI Semibold" Margin="0,2,0,14"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Module" Style="{StaticResource Muted}" Margin="0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="MDB622 - Design and Manipulate Databases (NQF 6)" Margin="0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Programme" Style="{StaticResource Muted}" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="OCC: Software Engineer, Year 2" Margin="0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Data access" Style="{StaticResource Muted}" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="ADO.NET (Microsoft.Data.SqlClient) over SQL Server" Margin="0,4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Platform" Style="{StaticResource Muted}" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text=".NET 8 (WPF)" Margin="0,4"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Database" Style="{StaticResource Muted}" Margin="0,4"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="SAA_FlightBooking" Margin="0,4"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
