<UserControl x:Class="SAA.DesktopApp.Views.CustomerResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid Margin="48,28,48,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock x:Name="RouteTitle" Style="{StaticResource H1}"/>
                <TextBlock Text="Select a flight to continue to booking." Style="{StaticResource Muted}"/>
            </StackPanel>
            <Button Content="New search" Style="{StaticResource SecondaryButton}" Click="Back_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Top"/>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Results">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                        <TextBlock Text="{Binding FlightNumber}" FontFamily="Segoe UI Semibold" FontSize="18"
                                                   Foreground="{StaticResource Navy}"/>
                                        <TextBlock Text="{Binding Aircraft}" Style="{StaticResource Muted}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" Foreground="{StaticResource TextDark}">
                                            <Run Text="{Binding DepartureCity}"/><Run Text="  &#x2192;  "/><Run Text="{Binding ArrivalCity}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Muted}">
                                            <Run Text="{Binding DepartureTime, StringFormat='ddd dd MMM HH:mm'}"/>
                                            <Run Text="  -  "/>
                                            <Run Text="{Binding ArrivalTime, StringFormat='HH:mm'}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="24,0,20,0">
                                        <TextBlock Text="from" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding BaseFare, StringFormat='R {0:N2}'}" FontFamily="Segoe UI Semibold"
                                                   FontSize="18" Foreground="{StaticResource Navy}" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <Button Grid.Column="3" Content="Select" VerticalAlignment="Center"
                                            Padding="22,9" Click="Select_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <ProgressBar IsIndeterminate="True" Width="180" Height="4"/>
                <TextBlock Text="Searching flights..." Style="{StaticResource Muted}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Visibility="Collapsed">
                <TextBlock Text="No flights on this route" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                <TextBlock Text="Try a different departure or destination." Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel x:Name="Error" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Visibility="Collapsed">
                <TextBlock Text="Could not load flights" Style="{StaticResource H2}" HorizontalAlignment="Center" Foreground="#D9534F"/>
                <TextBlock x:Name="ErrorText" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
