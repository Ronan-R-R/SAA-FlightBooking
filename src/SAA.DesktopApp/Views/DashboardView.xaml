<UserControl x:Class="SAA.DesktopApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Dashboard" Style="{StaticResource H1}"/>
            <TextBlock Text="South African Airways Flight Booking System - overview" Style="{StaticResource Muted}"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Rows="1" Columns="4">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Passengers" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="PassengersCount" Text="-" FontSize="34" FontFamily="Segoe UI Semibold" Foreground="{StaticResource Navy}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="10,0,10,0">
                <StackPanel>
                    <TextBlock Text="Flights" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="FlightsCount" Text="-" FontSize="34" FontFamily="Segoe UI Semibold" Foreground="{StaticResource Navy}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="10,0,10,0">
                <StackPanel>
                    <TextBlock Text="Bookings" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="BookingsCount" Text="-" FontSize="34" FontFamily="Segoe UI Semibold" Foreground="{StaticResource Navy}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Ticket Revenue (ZAR)" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="RevenueTotal" Text="-" FontSize="34" FontFamily="Segoe UI Semibold" Foreground="{StaticResource Gold}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="About this system" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="This desktop client connects to the SAA_FlightBooking SQL Server database using ADO.NET. Use the navigation on the left to browse passengers, flights and bookings, and to view the revenue report. Data is read live from the database each time a view is opened or refreshed."/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <ProgressBar IsIndeterminate="True" Width="180" Height="4"/>
                <TextBlock Text="Loading overview..." Style="{StaticResource Muted}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="Error" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Visibility="Collapsed">
                <TextBlock Text="Could not load overview" Style="{StaticResource H2}" HorizontalAlignment="Center" Foreground="#D9534F"/>
                <TextBlock x:Name="ErrorText" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
