<UserControl x:Class="SAA.DesktopApp.Views.TicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Tickets" Style="{StaticResource H1}"/>
                <TextBlock Text="Issue, edit and remove tickets. A passenger must be a traveller on the booking." Style="{StaticResource Muted}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Add" Click="Add_Click" Margin="0,0,8,0" MinWidth="80"/>
                <Button x:Name="EditButton" Content="Edit" Style="{StaticResource SecondaryButton}" Click="Edit_Click" Margin="0,0,8,0" MinWidth="80" IsEnabled="False"/>
                <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource DangerButton}" Click="Delete_Click" Margin="0,0,8,0" MinWidth="80" IsEnabled="False"/>
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Click="Refresh_Click" MinWidth="80"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="Grid" SelectionChanged="Grid_SelectionChanged" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding TicketId}" Width="55"/>
                        <DataGridTextColumn Header="Booking" Binding="{Binding BookingReference}" Width="130"/>
                        <DataGridTextColumn Header="Passenger" Binding="{Binding PassengerName}" Width="*"/>
                        <DataGridTextColumn Header="Flight" Binding="{Binding FlightNumber}" Width="90"/>
                        <DataGridTextColumn Header="Seat" Binding="{Binding SeatNumber}" Width="70"/>
                        <DataGridTextColumn Header="Class" Binding="{Binding TicketClass}" Width="100"/>
                        <DataGridTextColumn Header="Fare" Binding="{Binding Fare, StringFormat='R {0:N2}'}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4"/>
                    <TextBlock Text="Loading tickets..." Style="{StaticResource Muted}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="Empty" Text="No tickets yet. Use Add to issue one." Style="{StaticResource Muted}"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>

                <StackPanel x:Name="Error" VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="420" Visibility="Collapsed">
                    <TextBlock Text="Could not load data" Style="{StaticResource H2}" HorizontalAlignment="Center" Foreground="#D9534F"/>
                    <TextBlock x:Name="ErrorText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
