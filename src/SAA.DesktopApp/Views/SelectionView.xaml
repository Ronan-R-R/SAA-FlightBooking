<UserControl x:Class="SAA.DesktopApp.Views.SelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A2540" Offset="0"/>
                <GradientStop Color="#071B2F" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="820">
            <TextBlock HorizontalAlignment="Center">
                <Run Text="SAA" FontSize="44" FontFamily="Segoe UI Black" Foreground="#C8A24B"/>
                <Run Text="  Airways" FontSize="34" FontFamily="Segoe UI Light" Foreground="White"/>
            </TextBlock>
            <TextBlock Text="Flight Booking System" Foreground="#9FB2C6" FontSize="15"
                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock Text="Choose how you want to continue" Foreground="#C7D3E0" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,26,0,20"/>

            <UniformGrid Rows="1" Columns="2">
                <Border Margin="0,0,12,0" CornerRadius="10" Background="White" Cursor="Hand"
                        MouseLeftButtonUp="Customer_Click">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.28" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Margin="28,30">
                        <Border Width="52" Height="52" CornerRadius="26" Background="#1B6EC2" HorizontalAlignment="Left">
                            <TextBlock Text="&#x2708;" FontSize="24" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Book flights" FontFamily="Segoe UI Semibold" FontSize="21"
                                   Foreground="{StaticResource Navy}" Margin="0,16,0,0"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,6,0,16"
                                   Text="Search flights, choose your travellers and pay. The customer booking experience."/>
                        <Button Content="Enter customer site" Click="Customer_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Margin="12,0,0,0" CornerRadius="10" Background="White" Cursor="Hand"
                        MouseLeftButtonUp="Admin_Click">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.28" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Margin="28,30">
                        <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource Navy}" HorizontalAlignment="Left">
                            <TextBlock Text="&#x2699;" FontSize="24" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Admin console" FontFamily="Segoe UI Semibold" FontSize="21"
                                   Foreground="{StaticResource Navy}" Margin="0,16,0,0"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,6,0,16"
                                   Text="Manage airports, passengers, flights, bookings, tickets and payments, and view reports."/>
                        <Button Content="Open admin console" Style="{StaticResource SecondaryButton}" Click="Admin_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="CTU PM02 - South African Airways" Foreground="#5E7488" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,26,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
