<UserControl x:Class="SAA.DesktopApp.Views.AdminShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackground}" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Navy}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,26,20,20">
                    <TextBlock>
                        <Run Text="SAA" FontSize="26" FontFamily="Segoe UI Black" Foreground="#C8A24B"/>
                        <Run Text="  Admin" FontSize="18" FontFamily="Segoe UI Light" Foreground="White"/>
                    </TextBlock>
                    <TextBlock Text="Flight Booking System" Foreground="#9FB2C6" FontSize="12" Margin="0,2,0,0"/>
                    <Border Background="#12FFFFFF" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <TextBlock Text="CTU PM02" Foreground="#C8A24B" FontSize="11" FontFamily="Segoe UI Semibold"/>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="20,10,20,18">
                    <Rectangle Height="1" Fill="#1E3A55" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#E0A800" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Checking database..." Foreground="#9FB2C6"
                                   FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="Log out" Style="{StaticResource SecondaryButton}" Click="Logout_Click"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>

                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Margin="12,10,12,0"
                         SelectionChanged="Nav_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <StaticResource ResourceKey="NavItem"/>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Content="Dashboard" IsSelected="True"/>
                    <ListBoxItem Content="Airports"/>
                    <ListBoxItem Content="Passengers"/>
                    <ListBoxItem Content="Flights"/>
                    <ListBoxItem Content="Bookings"/>
                    <ListBoxItem Content="Tickets"/>
                    <ListBoxItem Content="Payments"/>
                    <ListBoxItem Content="Revenue Report"/>
                    <ListBoxItem Content="About"/>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="28,26,28,26"/>
    </Grid>
</UserControl>
